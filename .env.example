# Copy to .env at the repo root and adjust. .env is gitignored; this file is not.

# --- Postgres ---
POSTGRES_USER=jobmatch
POSTGRES_PASSWORD=jobmatch
POSTGRES_DB=jobmatch

# Connection string used by the backend.
# Note the driver: psycopg 3 is "postgresql+psycopg://" (NOT "postgresql+psycopg2://").
#
# The value below is the bare-metal default (running uvicorn from backend/ against the
# Postgres port that docker-compose publishes on localhost). docker-compose overrides it
# to point at the "db" service instead — same pattern as BACKEND_INTERNAL_URL.
DATABASE_URL=postgresql+psycopg://jobmatch:jobmatch@localhost:5432/jobmatch

# --- Storage ---
# Where generated resume PDFs are written. Compose overrides this to the shared volume
# mounted at /data/resumes.
RESUME_DIR=./.resumes

# --- LLM ---
# Optional server-side fallback for local development. In normal use the provider and key
# arrive per-request from the browser and are never persisted.
ANTHROPIC_API_KEY=
